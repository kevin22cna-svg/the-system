//@version=6
// =============================================================================
// WILEY STRAT — EMA-Fan + 4-Level + Zone/Structure + ORB + Volume Stars
// Best on SPY / QQQ / IWM and mega-caps, 1m–5m chart, EXTENDED HOURS ON.
// CVD removed — use dedicated TradingView CVD indicator at bottom of chart.
// =============================================================================
indicator("Wiley Strat", shorttitle="WILEY", overlay=true,
     max_lines_count=500, max_labels_count=500)

// ----------------------------- INPUTS ---------------------------------------
grpEMA   = "EMA Fan"
len1     = input.int(13,  "Fast EMA",   group=grpEMA)
len2     = input.int(48,  "Mid EMA",    group=grpEMA)
len3     = input.int(200, "Slow EMA",   group=grpEMA)
spacePct = input.float(0.15, "Min fan spread % (spacing-out gate)", step=0.05, group=grpEMA,
     tooltip="EMA fan must be spread at least this % of price to count as 'spacing out' (not choppy).")

grpLvl   = "Casey Levels"
showLvls = input.bool(true, "Show PDH/PDL/PMH/PML", group=grpLvl)
showVWAP = input.bool(true, "Show VWAP", group=grpLvl)

grpORB   = "Opening Range Breakout"
orbMin   = input.int(15, "Opening range minutes", minval=1, group=grpORB)
showORB  = input.bool(true, "Show ORB high/low", group=grpORB)
reqORB   = input.bool(false, "Require ORB break for A+ signal", group=grpORB)

grpBrk   = "Breakout volume stars"
showBrk  = input.bool(true, "Mark level breaks (green = high vol, red = low vol)", group=grpBrk)
volMult  = input.float(1.5, "High-volume multiple (x 20-bar avg)", step=0.1, minval=1.0, group=grpBrk)

grpScore = "A+ Scorecard"
thresh   = input.int(7, "Min score to signal (7+ = full size, max 10)", minval=1, maxval=10, group=grpScore)
use200   = input.bool(true, "Require price below 200 EMA for puts / above for calls", group=grpScore)
pivLen   = input.int(5, "Structure pivot strength (HH/HL/LH/LL)", minval=2, group=grpScore)
showTbl  = input.bool(true, "Show scorecard table", group=grpScore)

// ----------------------------- EMA FAN --------------------------------------
e13  = ta.ema(close, len1)
e48  = ta.ema(close, len2)
e200 = ta.ema(close, len3)

plot(e13,  "EMA 13",  color=color.yellow, linewidth=2)
plot(e48,  "EMA 48",  color=color.purple, linewidth=2)
plot(e200, "EMA 200", color=color.red,    linewidth=2)

bullAligned = e13 > e48 and e48 > e200
bearAligned = e200 > e48 and e48 > e13
fanSpread   = (math.max(e13, e48, e200) - math.min(e13, e48, e200)) / close * 100.0
spacingOut  = fanSpread >= spacePct
choppy      = not spacingOut

dir = bullAligned ? 1 : bearAligned ? -1 : 0

// ----------------------- SESSION + 4 LEVEL ENGINE ---------------------------
tz       = "America/New_York"
minsNY   = hour(time, tz) * 60 + minute(time, tz)
isRTH    = minsNY >= 570 and minsNY < 960
isPM     = minsNY >= 240 and minsNY < 570
dateKey  = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
isNewDay = dateKey != dateKey[1]
rthOpen  = isRTH and not isRTH[1]

var float pmH = na, var float pmL = na
var float rthH = na, var float rthL = na
var float pdh = na,  var float pdl = na
var float pmhF = na, var float pmlF = na

if isNewDay
    pdh  := rthH
    pdl  := rthL
    rthH := na
    rthL := na
    pmH  := na
    pmL  := na
    pmhF := na
    pmlF := na

if isPM
    pmH := na(pmH) ? high : math.max(pmH, high)
    pmL := na(pmL) ? low  : math.min(pmL, low)

if rthOpen
    pmhF := pmH
    pmlF := pmL

if isRTH
    rthH := na(rthH) ? high : math.max(rthH, high)
    rthL := na(rthL) ? low  : math.min(rthL, low)

plot(showLvls ? pdh  : na, "PDH", color=color.new(color.lime,    0), style=plot.style_stepline)
plot(showLvls ? pdl  : na, "PDL", color=color.new(color.orange,  0), style=plot.style_stepline)
plot(showLvls ? pmhF : na, "PMH", color=color.new(color.aqua,   40), style=plot.style_stepline)
plot(showLvls ? pmlF : na, "PML", color=color.new(color.fuchsia,40), style=plot.style_stepline)

vwapV = ta.vwap(hlc3)
plot(showVWAP ? vwapV : na, "VWAP", color=color.new(color.gray, 0), linewidth=1)

// ------------------------ OPENING RANGE BREAKOUT ----------------------------
orbEnd = 570 + orbMin
inORB  = isRTH and minsNY < orbEnd
var float orbH = na, var float orbL = na
if isNewDay
    orbH := na
    orbL := na
if inORB
    orbH := na(orbH) ? high : math.max(orbH, high)
    orbL := na(orbL) ? low  : math.min(orbL, low)
orbSet = not na(orbH) and isRTH and minsNY >= orbEnd
orbUp  = orbSet and close > orbH
orbDn  = orbSet and close < orbL

plot(showORB ? orbH : na, "ORB High", color=color.new(color.green,  0), style=plot.style_stepline, linewidth=2)
plot(showORB ? orbL : na, "ORB Low",  color=color.new(color.maroon, 0), style=plot.style_stepline, linewidth=1)

// ----------------- BREAKOUT VOLUME STARS ------------------------------------
volAvg  = ta.sma(volume, 20)
hiVol   = volume > volAvg * volMult
upBreak = isRTH and ((not na(pmhF) and close > pmhF and close[1] <= pmhF) or (not na(pdh) and close > pdh and close[1] <= pdh) or (orbSet and close > orbH and close[1] <= orbH))
dnBreak = isRTH and ((not na(pmlF) and close < pmlF and close[1] >= pmlF) or (not na(pdl) and close < pdl and close[1] >= pdl) or (orbSet and close < orbL and close[1] >= orbL))
plotshape(showBrk and upBreak and hiVol,     "Break up hi-vol", shape.circle, location.abovebar, color.new(color.green, 0), size=size.small)
plotshape(showBrk and upBreak and not hiVol, "Break up lo-vol", shape.circle, location.abovebar, color.new(color.red,   0), size=size.small)
plotshape(showBrk and dnBreak and hiVol,     "Break dn hi-vol", shape.circle, location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(showBrk and dnBreak and not hiVol, "Break dn lo-vol", shape.circle, location.belowbar, color.new(color.red,   0), size=size.small)
alertcondition(upBreak and hiVol, "Wiley HI-VOL breakout up",  "Level break above on high volume (conviction)")
alertcondition(dnBreak and hiVol, "Wiley HI-VOL breakdown",    "Level break below on high volume (conviction)")

// ----------------------- DAY-TYPE CLASSIFICATION ----------------------------
abovePDH = not na(pdh)  and close > pdh
belowPDL = not na(pdl)  and close < pdl
abovePMH = not na(pmhF) and close > pmhF
belowPML = not na(pmlF) and close < pmlF

dayType = "BALANCED — cautious, small size"
if abovePDH and abovePMH
    dayType := "STRONGEST BULL — full size calls"
else if abovePDH
    dayType := "BULL TREND — favor calls"
else if abovePMH
    dayType := "BREAKOUT WATCH — first bull sign"
else if belowPDL
    dayType := "BEAR TREND — favor puts"
else if belowPML
    dayType := "BREAKDOWN WATCH — first bear sign"
else if not na(pmhF) and not na(pmlF) and close <= pmhF and close >= pmlF
    dayType := "CHOP ZONE — wait for expansion"

// ----------------- PRICE STRUCTURE (HH/HL/LH/LL) ----------------------------
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)
var float lastPH = na, var float prevPH = na
var float lastPL = na, var float prevPL = na
if not na(ph)
    prevPH := lastPH
    lastPH := ph
if not na(pl)
    prevPL := lastPL
    lastPL := pl
HH = not na(lastPH) and not na(prevPH) and lastPH > prevPH
HL = not na(lastPL) and not na(prevPL) and lastPL > prevPL
LH = not na(lastPH) and not na(prevPH) and lastPH < prevPH
LL = not na(lastPL) and not na(prevPL) and lastPL < prevPL
bullStruct = HH and HL
bearStruct = LH and LL

// --------------------- 15-MIN BODY CLOSE ------------------------------------
c15 = request.security(syminfo.tickerid, "15", close, lookahead=barmerge.lookahead_off)

// --------------------- CANDLE PATTERN + 13 EMA PULLBACK ---------------------
bodyLo  = math.min(open, close)
bodyHi  = math.max(open, close)
bodyAbs = math.abs(close - open)
bullPat = (bodyLo - low)  > bodyAbs * 1.5 and close >= open
bearPat = (high - bodyHi) > bodyAbs * 1.5 and close <= open

bullPB  = low  <= e13 and close > e13 and close > open
bearPB  = high >= e13 and close < e13 and close < open

// ----------------------------- A+ SCORECARD ---------------------------------
sFan    = (bullAligned or bearAligned) and spacingOut ? 2 : 0
s15     = dir ==  1 and not na(pmhF) and c15 > pmhF ? 2 : dir == -1 and not na(pmlF) and c15 < pmlF ? 2 : 0
sStruct = dir ==  1 and bullStruct ? 2 : dir == -1 and bearStruct ? 2 : 0
sPat    = dir ==  1 and bullPat    ? 1 : dir == -1 and bearPat    ? 1 : 0
sPB     = dir ==  1 and bullPB     ? 1 : dir == -1 and bearPB     ? 1 : 0
sVWAP   = dir ==  1 and close > vwapV ? 1 : dir == -1 and close < vwapV ? 1 : 0
sORB    = dir ==  1 and orbUp ? 1 : dir == -1 and orbDn ? 1 : 0
score   = sFan + s15 + sStruct + sPat + sPB + sVWAP + sORB

longOK    = not use200 or close > e200
shortOK   = not use200 or close < e200
orbLongOK = not reqORB or orbUp
orbShrtOK = not reqORB or orbDn

longSig  = isRTH and dir ==  1 and score >= thresh and sPB == 1 and longOK  and orbLongOK
shortSig = isRTH and dir == -1 and score >= thresh and sPB == 1 and shortOK and orbShrtOK

plotshape(longSig,  "Long A+",  shape.triangleup,   location.belowbar, color.new(color.lime,0), size=size.small, text="A+")
plotshape(shortSig, "Short A+", shape.triangledown, location.abovebar, color.new(color.red,0),  size=size.small, text="A+")

alertcondition(longSig,  "Wiley LONG A+",  "Wiley Strat LONG A+ setup (score >= threshold)")
alertcondition(shortSig, "Wiley SHORT A+", "Wiley Strat SHORT A+ setup (score >= threshold)")
alertcondition(orbUp and not orbUp[1], "Wiley ORB break UP",   "Price broke above the opening range high")
alertcondition(orbDn and not orbDn[1], "Wiley ORB break DOWN", "Price broke below the opening range low")

// ----------------------------- SCORECARD TABLE ------------------------------
f_yn(b) => b ? "+" : "."

f_dt(s) =>
    s == "STRONGEST BULL — full size calls"  ? "STR BULL" :
     s == "BULL TREND — favor calls"          ? "BULL"     :
     s == "BREAKOUT WATCH — first bull sign"  ? "BRK OUT"  :
     s == "BEAR TREND — favor puts"           ? "BEAR"     :
     s == "BREAKDOWN WATCH — first bear sign" ? "BRK DWN"  :
     s == "CHOP ZONE — wait for expansion"    ? "CHOP"     : "BAL"

if showTbl and barstate.islast
    var table t = table.new(position.top_right, 2, 10, border_width=1, frame_width=1)
    bg  = color.new(color.black, 20)
    hdr = score >= 8 ? color.new(color.green, 0) : score >= thresh ? color.new(color.teal, 0) : color.new(color.gray, 20)
    sz  = size.small
    table.cell(t, 0, 0, "WILEY " + (dir==1?"▲":dir==-1?"▼":"—"), text_color=color.white, bgcolor=hdr, text_size=sz)
    table.cell(t, 1, 0, str.tostring(score) + "/10 " + f_dt(dayType), text_color=color.white, bgcolor=hdr, text_size=sz)
    table.cell(t, 0, 1, "Fan+2",    text_color=color.silver, bgcolor=bg, text_size=sz)
    table.cell(t, 1, 1, f_yn(sFan>0) + " " + (choppy?"chop":str.tostring(fanSpread,"#.#")+"%"), text_color=color.white, bgcolor=bg, text_size=sz)
    table.cell(t, 0, 2, "15m+2",    text_color=color.silver, bgcolor=bg, text_size=sz)
    table.cell(t, 1, 2, f_yn(s15>0), text_color=color.white, bgcolor=bg, text_size=sz)
    table.cell(t, 0, 3, "Struct+2", text_color=color.silver, bgcolor=bg, text_size=sz)
    table.cell(t, 1, 3, f_yn(sStruct>0) + " " + (bullStruct?"HH/HL":bearStruct?"LH/LL":"-"), text_color=color.white, bgcolor=bg, text_size=sz)
    table.cell(t, 0, 4, "Candle+1", text_color=color.silver, bgcolor=bg, text_size=sz)
    table.cell(t, 1, 4, f_yn(sPat>0), text_color=color.white, bgcolor=bg, text_size=sz)
    table.cell(t, 0, 5, "13p+1",    text_color=color.silver, bgcolor=bg, text_size=sz)
    table.cell(t, 1, 5, f_yn(sPB>0), text_color=color.white, bgcolor=bg, text_size=sz)
    table.cell(t, 0, 6, "VWAP+1",   text_color=color.silver, bgcolor=bg, text_size=sz)
    table.cell(t, 1, 6, f_yn(sVWAP>0), text_color=color.white, bgcolor=bg, text_size=sz)
    table.cell(t, 0, 7, "ORB+1",    text_color=color.silver, bgcolor=bg, text_size=sz)
    table.cell(t, 1, 7, f_yn(sORB>0) + (na(orbH)?" …":orbUp?" ▲":orbDn?" ▼":" set"), text_color=color.white, bgcolor=bg, text_size=sz)
    table.cell(t, 0, 8, "PDH/L",    text_color=color.silver, bgcolor=bg, text_size=sz)
    table.cell(t, 1, 8, str.tostring(pdh, format.mintick) + "/" + str.tostring(pdl, format.mintick), text_color=color.white, bgcolor=bg, text_size=sz)
    table.cell(t, 0, 9, "PMH/L",    text_color=color.silver, bgcolor=bg, text_size=sz)
    table.cell(t, 1, 9, str.tostring(pmhF, format.mintick) + "/" + str.tostring(pmlF, format.mintick), text_color=color.white, bgcolor=bg, text_size=sz)
